# Copy to .env (never commit .env). All values are optional.

# --- LLM (Abhijeet's module) ---------------------------------------------
# MOCK_LLM=true needs no key, no network and no local model.
MOCK_LLM=true
LLM_PROVIDER=ollama              # ollama | openai | anthropic | gemini | mock
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_S=30
OLLAMA_BASE_URL=http://localhost:11434
# Only for hosted providers (leave empty otherwise):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Data and optimizer ----------------------------------------------------
# Default: carbonwise-data/data/carbonwise.sqlite3
CARBONWISE_DB_PATH=
# Default: carbonwise-data/config/optimizer.yaml
CARBONWISE_CONFIG=
# Default: carbonwise-data/synthetic_data/main (loaded when the DB is empty)
CARBONWISE_SEED_DIR=
SOLVER_TIME_LIMIT_S=20
SOLVER_TOTAL_LIMIT_S=90

# --- UI ----------------------------------------------------------------------
CARBONWISE_API_URL=http://localhost:8000
